POSTGRES_DB=emporio
POSTGRES_USER=emporio
POSTGRES_PASSWORD=emporio_local
POSTGRES_PORT=5432
# Usado na execução fora do Docker; o Compose configura o host como db.
POSTGRES_HOST=localhost
API_PORT=8000
# Obrigatório: preencha com um segredo próprio de pelo menos 32 caracteres.
# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# HTTP local: false. Ao publicar com HTTPS, altere para true.
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_MINUTES=120
# Com proxy reverso, acrescente o IP ou a rede confiável do seu proxy,
# separado por vírgula. Necessário para reconhecer HTTPS e permitir o login.
# Sem proxy, mantenha o valor local abaixo.
FORWARDED_ALLOW_IPS=127.0.0.1
# Senha das contas de demonstração: de 10 a 128 caracteres.
DEMO_PASSWORD=senha12345
# Obrigatória para gerar os embeddings do manual na primeira inicialização.
GOOGLE_API_KEY=
# Obrigatória para o modelo de chat padrão configurado abaixo.
OPENROUTER_API_KEY=
CHAT_PRIMARY_MODEL=openrouter/deepseek/deepseek-v4.1-flash
CHAT_FALLBACK_MODEL=
CHAT_MODEL_TIMEOUT=20
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_MAX_MODEL_CALLS=6
CHAT_MAX_TOOL_CALLS=12
CHAT_HISTORY_MAX_MESSAGES=100
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_CONTEXT_TOKENS=2000
RAG_CHUNK_TOKENS=1000
